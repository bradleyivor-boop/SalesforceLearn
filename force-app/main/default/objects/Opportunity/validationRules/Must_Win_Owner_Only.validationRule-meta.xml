<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Must_Win_Owner_Only</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISCHANGED(Must_Win_Opportunity__c),
  OwnerId &lt;&gt; $User.Id
)</errorConditionFormula>
    <errorDisplayField>Must_Win_Opportunity__c</errorDisplayField>
    <errorMessage>Only the Opportunity owner can set or change Must Win Opportunity.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quote_Sent_Requires_Quote</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(StageName, &quot;Quote Sent&quot;),
  ISBLANK(SyncedQuoteId)
)</errorConditionFormula>
    <errorMessage>You can&apos;t move this Opportunity to Quote Sent without a synced Quote attached.</errorMessage>
</ValidationRule>
